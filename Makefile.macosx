# The intent of this Makefile
# is to build and install `lua-cryptorandom`
# easier on macOS.
# For a feature-complete Makefile,
# take a look at `Makefile.unix`.

PREFIX = /usr/local
CCDEFINES = -DLUA_CRYPTORANDOM_BUILD_SHARED -DLUA_CRYPTORANDOM_USE_APPLE
CCPIC = -fPIC
CCDEBINFO =
CCSTD =
CCOPT = -O2
CCWARN = -Wall -Wextra
CFLAGS = $(CCDEBINFO) $(CCSTD) $(CCPIC) $(CCOPT) $(CCWARN)
CFLAGS_EXTRA =
LDFLAGS_EXTRA =
SOFLAGS = -bundle -undefined dynamic_lookup -all_load
LUA_DIR = $(PREFIX)
LUA_VERSION = 5.1
LUA_INCDIR = $(LUA_DIR)/include
LUA_LIBDIR = $(LUA_DIR)/lib
INSTALL_PREFIX = $(PREFIX)
INSTALL_LIBDIR = $(INSTALL_PREFIX)/lib/lua/$(LUA_VERSION)

MAKEFILE_COMMON_FLAGS = -f Makefile.unix

.PHONY: all
all: lib

.PHONY: lib
lib:
	$(MAKE) $(MAKEFILE_COMMON_FLAGS) "RANDOMLIB_INCDIR=$(LUA_INCDIR)" "CCDEFINES=$(CCDEFINES)" "CFLAGS_EXTRA=$(CFLAGS_EXTRA)" "SOFLAGS=$(SOFLAGS)" "LDFLAGS_EXTRA=$(LDFLAGS_EXTRA)" "LIBS=" lib

.PHONY: install
install:
	$(MAKE) $(MAKEFILE_COMMON_FLAGS) "INSTALL_CMOD=$(INSTALL_LIBDIR)" install

.PHONY: test
test:
	$(MAKE) $(MAKEFILE_COMMON_FLAGS) test

.PHONY: clean
clean:
	$(MAKE) $(MAKEFILE_COMMON_FLAGS) clean

.PHONY: very-clean
very-clean:
	$(MAKE) $(MAKEFILE_COMMON_FLAGS) very-clean
